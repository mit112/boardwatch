.venv/
__pycache__/
*.pyc
.coverage
# pytest-xdist writes one data file PER WORKER as `.coverage.<host>.<pid>.<rand>`, which the
# bare `.coverage` line above does not match. Without this a `git add -A` run while a gate is in
# flight commits several MB of binaries — it has happened.
.coverage.*
coverage.xml

# Playwright MCP scratch output — console logs, page snapshots and screenshots, written into the
# repo root by the browser tooling. 6.3 MB across 67 files by 2026-08-28g, from several sessions.
.playwright-mcp/
dist/
_alembic_dev.db
.agent/*
.superpowers/*
reasonix.toml
.reasonix-runs/
.DS_Store
scratchpad/
web/node_modules/

# SQLite stores. A stray one reached a commit on 2026-09-02: a shell with an unset variable
# created a literal `$BW/` directory in the repo root and `git add -A` swept the database in.
# CLAUDE.md forbids committing live-store artifacts, and an untracked store is one `add -A`
# away from becoming a tracked one that a later run writes real postings into.
*.db
*.db-shm
*.db-wal
